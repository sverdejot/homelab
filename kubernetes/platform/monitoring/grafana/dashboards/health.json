{
  "uid": "homelab-health",
  "title": "Salud del clúster",
  "description": "¿Hay algo roto? Nodos, pods, workloads, volúmenes y certificados",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Problemas detectados",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Nodos",
      "description": "Nodos no listos o con presión de memoria, disco o procesos.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(kube_node_info) - (sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"}) or vector(0)) + (count(kube_node_status_condition{condition=~\".+Pressure\",status=\"true\"} == 1) or vector(0))",
          "legendFormat": "Nodos",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Pods",
      "description": "Pods pendientes, fallidos o con contenedores esperando (CrashLoopBackOff, ImagePullBackOff…).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (namespace, pod, reason) (kube_pod_container_status_waiting_reason == 1) or max by (namespace, pod, reason) (label_replace(kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"} == 1, \"reason\", \"$1\", \"phase\", \"(.+)\"))) or vector(0)",
          "legendFormat": "Pods",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Workloads",
      "description": "Deployments, StatefulSets o DaemonSets con réplicas no disponibles.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((label_replace(kube_deployment_status_replicas_unavailable > 0, \"workload\", \"$1\", \"deployment\", \"(.+)\")) or (label_replace(kube_statefulset_replicas - on (namespace, statefulset) kube_statefulset_status_replicas_ready > 0, \"workload\", \"$1\", \"statefulset\", \"(.+)\")) or (label_replace(kube_daemonset_status_number_unavailable > 0, \"workload\", \"$1\", \"daemonset\", \"(.+)\"))) or vector(0)",
          "legendFormat": "Workloads",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Volúmenes",
      "description": "Volúmenes de Longhorn degradados o fallidos.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(count(max by (volume) (longhorn_volume_robustness{state=~\"degraded|faulted\"}) == 1) or vector(0))",
          "legendFormat": "Volúmenes",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Reinicios (24 h)",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(round(increase(kube_pod_container_status_restarts_total[24h])))",
          "legendFormat": "Reinicios (24 h)",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Próximo certificado",
      "description": "Días hasta la caducidad del certificado más cercano a caducar. cert-manager los renueva antes de que caduquen.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min(min by (namespace, name) ((certmanager_certificate_expiration_timestamp_seconds - time()) / 86400))",
          "legendFormat": "Próximo certificado",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: días",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 7
              },
              {
                "color": "#fab219",
                "value": 14
              },
              {
                "color": "#0ca30c",
                "value": 30
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "row",
      "title": "Qué falla ahora",
      "collapsed": false,
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Pods con problemas",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (namespace, pod, reason) (kube_pod_container_status_waiting_reason == 1) or max by (namespace, pod, reason) (label_replace(kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"} == 1, \"reason\", \"$1\", \"phase\", \"(.+)\"))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "reason": 2,
              "Value #A": 3
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "reason": "Motivo"
            },
            "includeByName": {}
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Namespace",
                "Pod",
                "Motivo"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false,
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Ninguno"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Motivo"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ec835a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [
          {
            "displayName": "Pod",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "id": 9,
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "Workloads incompletos",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (namespace, workload) ((label_replace(kube_deployment_status_replicas_unavailable > 0, \"workload\", \"$1\", \"deployment\", \"(.+)\")) or (label_replace(kube_statefulset_replicas - on (namespace, statefulset) kube_statefulset_status_replicas_ready > 0, \"workload\", \"$1\", \"statefulset\", \"(.+)\")) or (label_replace(kube_daemonset_status_number_unavailable > 0, \"workload\", \"$1\", \"daemonset\", \"(.+)\")))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "workload": 1,
              "Value #A": 2
            },
            "renameByName": {
              "namespace": "Namespace",
              "workload": "Workload",
              "Value #A": "Réplicas sin disponibilidad"
            },
            "includeByName": {}
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Namespace",
                "Workload",
                "Réplicas sin disponibilidad"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false,
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Ninguno"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Réplicas sin disponibilidad"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#0ca30c",
                      "value": null
                    },
                    {
                      "color": "#ec835a",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [
          {
            "displayName": "Réplicas sin disponibilidad",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "id": 10,
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "row",
      "title": "Nodos y certificados",
      "collapsed": false,
      "id": 11,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Estado de los nodos",
      "description": "Condiciones que Kubernetes marca cuando un nodo se queda sin memoria, disco o procesos (presión).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (node) (kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (node) (kube_node_status_condition{condition=\"MemoryPressure\",status=\"true\"})",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (node) (kube_node_status_condition{condition=\"DiskPressure\",status=\"true\"})",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (node) (kube_node_status_condition{condition=\"PIDPressure\",status=\"true\"})",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "node": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "node": "Nodo",
              "Value #A": "Listo",
              "Value #B": "Sin memoria",
              "Value #C": "Sin disco",
              "Value #D": "Sin procesos"
            },
            "includeByName": {}
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Nodo",
                "Listo",
                "Sin memoria",
                "Sin disco",
                "Sin procesos"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Nodo"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "homelab-0": {
                        "color": "#3987e5",
                        "index": 0
                      },
                      "homelab-1": {
                        "color": "#d95926",
                        "index": 1
                      },
                      "homelab-2": {
                        "color": "#199e70",
                        "index": 2
                      },
                      "homelab-3": {
                        "color": "#c98500",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Listo"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Sí",
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "0": {
                        "text": "No",
                        "color": "#d03b3b",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sin memoria"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "No",
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "1": {
                        "text": "Sí",
                        "color": "#d03b3b",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sin disco"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "No",
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "1": {
                        "text": "Sí",
                        "color": "#d03b3b",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sin procesos"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "No",
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "1": {
                        "text": "Sí",
                        "color": "#d03b3b",
                        "index": 1
